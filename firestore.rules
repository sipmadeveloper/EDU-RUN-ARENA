rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================== GLOBAL HARDENED PRIMITIVES ====================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    // Bootstrapped Admin (verified email strictly required to block email spoofing)
    function isBootstrapAdmin() {
      return isVerifiedUser()
        && request.auth.token.email == 'sipmadeveloper@gmail.com';
    }

    // Full Admin check (bootstrap admin OR trusted /admins/{uid} registry doc)
    function isAdmin() {
      return isBootstrapAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() == 6 && code.matches('^[A-Z0-9]{6}$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function teacherProfileExists(teacherId) {
      return exists(/databases/$(database)/documents/teachers/$(teacherId));
    }

    function roomExists(roomCode) {
      return exists(/databases/$(database)/documents/rooms/$(roomCode));
    }

    function getRoom(roomCode) {
      return get(/databases/$(database)/documents/rooms/$(roomCode)).data;
    }

    // ==================== VALIDATION BLUEPRINTS (ANTI-UPDATE-GAP) ====================
    function isValidAdminAccount(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
      && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
      && isValidId(data.uid)
      && data.uid == adminId
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && isValidId(data.grantedBy)
      && data.grantedBy == request.auth.uid
      && data.createdAt is timestamp;
    }

    function isValidStadiumLedConfig(data) {
      return data.keys().hasAll([
        'enabled',
        'brightness',
        'repeatCount',
        'approxBytes',
        'slides',
        'updatedBy',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'enabled',
        'brightness',
        'repeatCount',
        'approxBytes',
        'slides',
        'updatedBy',
        'updatedAt'
      ])
      && data.enabled is bool
      && (data.brightness is int || data.brightness is float)
      && data.brightness >= 0.6 && data.brightness <= 1.4
      && data.repeatCount is int && data.repeatCount >= 12 && data.repeatCount <= 40
      && data.approxBytes is int && data.approxBytes >= 0 && data.approxBytes <= 320000
      && data.slides is list
      && data.slides.size() >= 1 && data.slides.size() <= 10
      && data.slides[0] is map
      && isValidId(data.updatedBy)
      && data.updatedBy == request.auth.uid
      && data.updatedAt is timestamp;
    }

    function isValidTeacherProfile(data, teacherId) {
      return data.keys().hasAll([
        'ownerId',
        'name',
        'email',
        'schoolName',
        'maxArchivedMatches',
        'retentionDays',
        'defaultVenue',
        'defaultQuestionCount',
        'defaultMaxPlayers',
        'defaultTimePerQuestion',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerId',
        'name',
        'email',
        'schoolName',
        'maxArchivedMatches',
        'retentionDays',
        'defaultVenue',
        'defaultQuestionCount',
        'defaultMaxPlayers',
        'defaultTimePerQuestion',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.ownerId)
      && data.ownerId == teacherId
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
      && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
      && data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 120
      && data.maxArchivedMatches is int && data.maxArchivedMatches >= 5 && data.maxArchivedMatches <= 25
      && data.retentionDays is int && data.retentionDays >= 7 && data.retentionDays <= 90
      && data.defaultVenue is string && data.defaultVenue.size() >= 1 && data.defaultVenue.size() <= 20
      && (data.defaultVenue == 'stadium_day' || data.defaultVenue == 'stadium_night' || data.defaultVenue == 'open_field')
      && data.defaultQuestionCount is int && data.defaultQuestionCount >= 1 && data.defaultQuestionCount <= 100
      && data.defaultMaxPlayers is int && data.defaultMaxPlayers >= 2 && data.defaultMaxPlayers <= 30
      && data.defaultTimePerQuestion is int && data.defaultTimePerQuestion >= 5 && data.defaultTimePerQuestion <= 120
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidQuestionPack(data) {
      return data.keys().hasAll([
        'ownerId',
        'packIndex',
        'questionCount',
        'approxBytes',
        'questions',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'ownerId',
        'packIndex',
        'questionCount',
        'approxBytes',
        'questions',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.ownerId)
      && data.ownerId == request.auth.uid
      && data.packIndex is int && data.packIndex >= 0 && data.packIndex <= 9
      && data.questionCount is int && data.questionCount >= 0 && data.questionCount <= 50
      && data.approxBytes is int && data.approxBytes >= 0 && data.approxBytes <= 250000
      && data.questions is list
      && data.questions.size() <= 50
      && data.questions.size() == data.questionCount
      && (data.questions.size() == 0 || data.questions[0] is map)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidMatchArchive(data) {
      return data.keys().hasAll([
        'ownerId',
        'roomCode',
        'roomName',
        'subject',
        'grade',
        'questionCount',
        'totalLaps',
        'participantCount',
        'avgScore',
        'championName',
        'status',
        'approxBytes',
        'standings',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'ownerId',
        'roomCode',
        'roomName',
        'subject',
        'grade',
        'questionCount',
        'totalLaps',
        'participantCount',
        'avgScore',
        'championName',
        'status',
        'approxBytes',
        'standings',
        'createdAt'
      ])
      && isValidId(data.ownerId)
      && data.ownerId == request.auth.uid
      && data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 && data.roomCode.matches('^[A-Z0-9]+$')
      && data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 100
      && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60
      && data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 30
      && data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 100
      && data.totalLaps is int && data.totalLaps >= 1 && data.totalLaps <= 20
      && data.participantCount is int && data.participantCount >= 0 && data.participantCount <= 30
      && (data.avgScore is int || data.avgScore is float) && data.avgScore >= 0 && data.avgScore <= 100
      && data.championName is string && data.championName.size() <= 60
      && data.status is string && data.status.size() <= 16 && data.status == 'archived'
      && data.approxBytes is int && data.approxBytes >= 0 && data.approxBytes <= 64000
      && data.standings is list
      && data.standings.size() <= 30
      && (data.standings.size() == 0 || data.standings[0] is map)
      && data.createdAt is timestamp;
    }

    function isValidLiveRoom(data, roomCode) {
      return data.keys().hasAll([
        'roomCode',
        'ownerId',
        'roomName',
        'teacherName',
        'schoolName',
        'subject',
        'grade',
        'status',
        'settings',
        'questionCount',
        'totalLaps',
        'pointsPerQuestion',
        'questions',
        'participantCount',
        'countdownStartMs',
        'startedAtMs',
        'finishedAtMs',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'roomCode',
        'ownerId',
        'roomName',
        'teacherName',
        'schoolName',
        'subject',
        'grade',
        'status',
        'settings',
        'questionCount',
        'totalLaps',
        'pointsPerQuestion',
        'questions',
        'participantCount',
        'countdownStartMs',
        'startedAtMs',
        'finishedAtMs',
        'createdAt',
        'updatedAt'
      ])
      && isValidRoomCode(data.roomCode)
      && data.roomCode == roomCode
      && isValidId(data.ownerId)
      && data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 100
      && data.teacherName is string && data.teacherName.size() >= 1 && data.teacherName.size() <= 100
      && data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 120
      && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60
      && data.grade is string && data.grade.size() >= 1 && data.grade.size() <= 30
      && data.status is string && data.status.size() <= 16
      && (data.status == 'waiting' || data.status == 'countdown' || data.status == 'playing' || data.status == 'finished')
      && data.settings is map
      && data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 50
      && data.totalLaps is int && data.totalLaps >= 1 && data.totalLaps <= 20
      && (data.pointsPerQuestion is int || data.pointsPerQuestion is float)
      && data.pointsPerQuestion >= 0 && data.pointsPerQuestion <= 100
      && data.questions is list
      && data.questions.size() >= 1 && data.questions.size() <= 50
      && data.questions.size() == data.questionCount
      && data.questions[0] is map
      && data.participantCount is int && data.participantCount >= 0 && data.participantCount <= 30
      && data.countdownStartMs is int && data.countdownStartMs >= 0
      && data.startedAtMs is int && data.startedAtMs >= 0
      && data.finishedAtMs is int && data.finishedAtMs >= 0
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    function isValidRoomParticipant(data, roomCode, participantId) {
      return data.keys().hasAll([
        'id',
        'roomCode',
        'reconnectToken',
        'name',
        'className',
        'avatar',
        'lane',
        'distance',
        'progress',
        'speed',
        'effectState',
        'effectExpiresAt',
        'currentQuestionIndex',
        'answeredCount',
        'correctCount',
        'wrongCount',
        'unansweredCount',
        'score',
        'connected',
        'startedAt',
        'finishedAt',
        'durationMs',
        'finishRank',
        'scoreRank',
        'lastSyncMs',
        'answers',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasOnly([
        'id',
        'roomCode',
        'reconnectToken',
        'name',
        'className',
        'avatar',
        'lane',
        'distance',
        'progress',
        'speed',
        'effectState',
        'effectExpiresAt',
        'currentQuestionIndex',
        'answeredCount',
        'correctCount',
        'wrongCount',
        'unansweredCount',
        'score',
        'connected',
        'startedAt',
        'finishedAt',
        'durationMs',
        'finishRank',
        'scoreRank',
        'lastSyncMs',
        'answers',
        'createdAt',
        'updatedAt'
      ])
      && isValidId(data.id)
      && data.id == participantId
      && isValidRoomCode(data.roomCode)
      && data.roomCode == roomCode
      && data.reconnectToken is string && data.reconnectToken.size() >= 8 && data.reconnectToken.size() <= 64
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
      && data.className is string && data.className.size() >= 1 && data.className.size() <= 24
      && data.avatar is map
      && data.lane is int && data.lane >= 0 && data.lane <= 29
      && (data.distance is int || data.distance is float) && data.distance >= 0 && data.distance <= 10000
      && (data.progress is int || data.progress is float) && data.progress >= 0 && data.progress <= 1
      && (data.speed is int || data.speed is float) && data.speed >= 0 && data.speed <= 60
      && data.effectState is string && data.effectState.size() <= 16
      && (data.effectState == 'normal' || data.effectState == 'boost' || data.effectState == 'penalty' || data.effectState == 'finished')
      && data.effectExpiresAt is int && data.effectExpiresAt >= 0
      && data.currentQuestionIndex is int && data.currentQuestionIndex >= 0 && data.currentQuestionIndex <= 50
      && data.answeredCount is int && data.answeredCount >= 0 && data.answeredCount <= 50
      && data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 50
      && data.wrongCount is int && data.wrongCount >= 0 && data.wrongCount <= 50
      && data.unansweredCount is int && data.unansweredCount >= 0 && data.unansweredCount <= 50
      && (data.score is int || data.score is float) && data.score >= 0 && data.score <= 100
      && data.connected is bool
      && data.startedAt is int && data.startedAt >= 0
      && data.finishedAt is int && data.finishedAt >= 0
      && data.durationMs is int && data.durationMs >= 0
      && data.finishRank is int && data.finishRank >= 0 && data.finishRank <= 30
      && data.scoreRank is int && data.scoreRank >= 0 && data.scoreRank <= 30
      && data.lastSyncMs is int && data.lastSyncMs >= 0
      && data.answers is list
      && data.answers.size() <= 50
      && (data.answers.size() == 0 || data.answers[0] is map)
      && data.createdAt is timestamp
      && data.updatedAt is timestamp;
    }

    // ==================== COLLECTION: /admins/{adminId} ====================
    // Trusted admin registry. Only bootstrap admin can manage admin records.
    match /admins/{adminId} {
      allow get: if (isOwner(adminId) || isBootstrapAdmin()) && isValidId(adminId);
      allow list: if isBootstrapAdmin();

      allow create: if isBootstrapAdmin()
        && isValidId(adminId)
        && isValidAdminAccount(incoming(), adminId)
        && incoming().createdAt == request.time;

      allow update: if false;

      allow delete: if isBootstrapAdmin() && isValidId(adminId);
    }

    // ==================== COLLECTION: /settings/{settingId} ====================
    // Public stadium display settings (zero PII). Strictly admin-only writes.
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'stadiumLed';
      allow list: if false;

      allow create: if isAdmin()
        && isValidId(settingId)
        && settingId == 'stadiumLed'
        && isValidStadiumLedConfig(incoming())
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(settingId)
        && settingId == 'stadiumLed'
        && isValidStadiumLedConfig(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'enabled',
          'brightness',
          'repeatCount',
          'approxBytes',
          'slides',
          'updatedBy',
          'updatedAt'
        ]);

      allow delete: if isAdmin()
        && isValidId(settingId)
        && settingId == 'stadiumLed';
    }

    // ==================== COLLECTION: /teachers/{teacherId} ====================
    // Contains PII (email). Strictly restricted to owner or verified Admin.
    match /teachers/{teacherId} {
      allow get: if (isOwner(teacherId) || isAdmin()) && isValidId(teacherId);

      // Strictly restricted to verified bootstrap admin (zero get()/exists() in allow list)
      allow list: if isBootstrapAdmin();

      allow create: if isOwner(teacherId)
        && isValidId(teacherId)
        && isValidTeacherProfile(incoming(), teacherId)
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(teacherId)
        && isValidTeacherProfile(incoming(), teacherId)
        && incoming().ownerId == existing().ownerId
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Tier 1 (Admin): May update any teacher's auto-cleanup retention controls
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'maxArchivedMatches',
              'retentionDays',
              'updatedAt'
            ])
          )
          ||
          // Tier 2 (Owner): May update own profile & settings
          (
            isOwner(teacherId)
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['name', 'schoolName', 'updatedAt'])
              ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'maxArchivedMatches',
                'retentionDays',
                'defaultVenue',
                'defaultQuestionCount',
                'defaultMaxPlayers',
                'defaultTimePerQuestion',
                'updatedAt'
              ])
              ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name',
                'schoolName',
                'maxArchivedMatches',
                'retentionDays',
                'defaultVenue',
                'defaultQuestionCount',
                'defaultMaxPlayers',
                'defaultTimePerQuestion',
                'updatedAt'
              ])
            )
          )
        );

      // Only verified Admin may remove a teacher cloud profile doc (after clearing subcollections)
      allow delete: if isAdmin() && isValidId(teacherId);

      // ==================== SUBCOLLECTION: questionPacks ====================
      match /questionPacks/{packId} {
        allow get: if (isOwner(teacherId) || isAdmin())
          && isValidId(teacherId)
          && isValidId(packId)
          && existing().ownerId == teacherId
          && teacherProfileExists(teacherId);

        // Pillar 8: Secure list query enforced via resource.data without get()/exists()
        allow list: if (isOwner(teacherId) && resource.data.ownerId == request.auth.uid)
          || (isBootstrapAdmin() && resource.data.ownerId == teacherId);

        allow create: if isOwner(teacherId)
          && isValidId(teacherId)
          && isValidId(packId)
          && isValidQuestionPack(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && teacherProfileExists(teacherId);

        allow update: if isOwner(teacherId)
          && isValidId(teacherId)
          && isValidId(packId)
          && isValidQuestionPack(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().packIndex == existing().packIndex
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'questionCount',
            'approxBytes',
            'questions',
            'updatedAt'
          ])
          && teacherProfileExists(teacherId);

        allow delete: if isVerifiedUser()
          && isValidId(teacherId)
          && isValidId(packId)
          && existing().ownerId == teacherId
          && ((isOwner(teacherId) && existing().ownerId == request.auth.uid) || isAdmin())
          && teacherProfileExists(teacherId);
      }

      // ==================== SUBCOLLECTION: matchArchives ====================
      match /matchArchives/{archiveId} {
        allow get: if (isOwner(teacherId) || isAdmin())
          && isValidId(teacherId)
          && isValidId(archiveId)
          && existing().ownerId == teacherId
          && teacherProfileExists(teacherId);

        // Pillar 8: Secure list query enforced via resource.data without get()/exists()
        allow list: if (isOwner(teacherId) && resource.data.ownerId == request.auth.uid)
          || (isBootstrapAdmin() && resource.data.ownerId == teacherId);

        allow create: if isOwner(teacherId)
          && isValidId(teacherId)
          && isValidId(archiveId)
          && isValidMatchArchive(incoming())
          && incoming().createdAt == request.time
          && teacherProfileExists(teacherId);

        // Pillar 4.6: Terminal State Locking — archived matches are immutable
        allow update: if false;

        allow delete: if isVerifiedUser()
          && isValidId(teacherId)
          && isValidId(archiveId)
          && existing().ownerId == teacherId
          && ((isOwner(teacherId) && existing().ownerId == request.auth.uid) || isAdmin())
          && teacherProfileExists(teacherId);
      }
    }

    // ==================== COLLECTION: /rooms/{roomCode} ====================
    // Live serverless multiplayer rooms (zero PII).
    // Students can look up by exact 6-char code (get), while listing and mutations require owning teacher.
    match /rooms/{roomCode} {
      allow get: if isValidRoomCode(roomCode);

      // Pillar 8: Secure list query enforced via resource.data without get()/exists()
      allow list: if (isVerifiedUser() && resource.data.ownerId == request.auth.uid)
        || isBootstrapAdmin();

      allow create: if isVerifiedUser()
        && isValidRoomCode(roomCode)
        && isValidLiveRoom(incoming(), roomCode)
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'waiting'
        && incoming().participantCount == 0
        && incoming().countdownStartMs == 0
        && incoming().startedAtMs == 0
        && incoming().finishedAtMs == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && teacherProfileExists(request.auth.uid);

      allow update: if isVerifiedUser()
        && isValidRoomCode(roomCode)
        && isValidLiveRoom(incoming(), roomCode)
        && (existing().ownerId == request.auth.uid || isAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().roomCode == existing().roomCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'finished'
        && (
          // Action 1: Start match countdown or transition to playing
          (
            (existing().status == 'waiting' || existing().status == 'countdown')
            && (incoming().status == 'countdown' || incoming().status == 'playing')
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'countdownStartMs',
              'startedAtMs',
              'participantCount',
              'updatedAt'
            ])
          )
          ||
          // Action 2: Finish match (terminal transition)
          (
            incoming().status == 'finished'
            && incoming().finishedAtMs > 0
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'finishedAtMs',
              'participantCount',
              'updatedAt'
            ])
          )
          ||
          // Action 3: Sync participant count
          (
            incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'participantCount',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser()
        && isValidRoomCode(roomCode)
        && (existing().ownerId == request.auth.uid || isAdmin());

      // ==================== SUBCOLLECTION: participants ====================
      // Students join and race via exact 6-char room code without requiring Google sign-in.
      // Strict schema, volumetric bounds, reconnectToken immutability, and terminal lock guard every write.
      match /participants/{participantId} {
        allow get: if isValidRoomCode(roomCode)
          && isValidId(participantId)
          && roomExists(roomCode);

        // Pillar 8: Zero get()/exists() in allow list; scoped to exact roomCode
        allow list: if isValidRoomCode(roomCode)
          && resource.data.roomCode == roomCode;

        allow create: if isValidRoomCode(roomCode)
          && isValidId(participantId)
          && isValidRoomParticipant(incoming(), roomCode, participantId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && incoming().answeredCount == 0
          && incoming().correctCount == 0
          && incoming().wrongCount == 0
          && incoming().unansweredCount == 0
          && incoming().score == 0
          && incoming().finishedAt == 0
          && incoming().finishRank == 0
          && incoming().scoreRank == 0
          && incoming().answers.size() == 0
          && roomExists(roomCode)
          && getRoom(roomCode).status != 'finished';

        allow update: if isValidRoomCode(roomCode)
          && isValidId(participantId)
          && isValidRoomParticipant(incoming(), roomCode, participantId)
          && incoming().id == existing().id
          && incoming().roomCode == existing().roomCode
          && incoming().lane == existing().lane
          && incoming().reconnectToken == existing().reconnectToken
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && roomExists(roomCode)
          && (
            // Tier 1: Owning teacher or Admin finalizing ranks on match finish
            (
              isVerifiedUser()
              && (getRoom(roomCode).ownerId == request.auth.uid || isAdmin())
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'effectState',
                'speed',
                'finishedAt',
                'durationMs',
                'finishRank',
                'scoreRank',
                'lastSyncMs',
                'updatedAt'
              ])
            )
            ||
            // Tier 2A: Rate-limited character position checkpoint (server-enforced >= 2s cooldown)
            (
              getRoom(roomCode).status != 'finished'
              && existing().finishedAt == 0
              && request.time >= existing().updatedAt + duration.value(2, 's')
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'distance',
                'progress',
                'speed',
                'effectState',
                'effectExpiresAt',
                'lastSyncMs',
                'updatedAt'
              ])
            )
            ||
            // Tier 2B: Lobby presence or avatar update on reconnect
            (
              getRoom(roomCode).status != 'finished'
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'avatar',
                'connected',
                'updatedAt'
              ])
            )
            ||
            // Tier 2C: Authoritative answer submission or finish crossing (unthrottled, terminal-locked)
            (
              getRoom(roomCode).status != 'finished'
              && existing().finishedAt == 0
              && (
                incoming().answeredCount > existing().answeredCount
                || incoming().finishedAt > 0
              )
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'distance',
                'progress',
                'speed',
                'effectState',
                'effectExpiresAt',
                'currentQuestionIndex',
                'answeredCount',
                'correctCount',
                'wrongCount',
                'unansweredCount',
                'score',
                'connected',
                'startedAt',
                'finishedAt',
                'durationMs',
                'finishRank',
                'lastSyncMs',
                'answers',
                'updatedAt'
              ])
            )
          );

        allow delete: if isVerifiedUser()
          && isValidRoomCode(roomCode)
          && isValidId(participantId)
          && roomExists(roomCode)
          && (getRoom(roomCode).ownerId == request.auth.uid || isAdmin());
      }
    }
  }
}
