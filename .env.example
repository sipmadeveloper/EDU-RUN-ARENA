# PORT: Port server Node.js (otomatis diisi oleh Render / Railway / Cloud Run)
PORT=3000

# NODE_ENV: Gunakan "production" saat deploy agar melayani hasil build dist/
NODE_ENV=production

# JWT_SECRET: Kunci acak buatan Anda sendiri untuk mengamankan token login guru
JWT_SECRET="ganti-dengan-teks-acak-panjang-bebas-anda"
